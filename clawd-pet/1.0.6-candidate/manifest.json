{
  "schema_version": 1,
  "toolpkg_id": "clawd_pet",
  "version": "1.0.6",
  "api_version": "1.0.1",
  "main": "main.js",
  "author": [
    "Mishio & Claude"
  ],
  "display_name": {
    "zh": "ClawdPet 像素桌宠",
    "en": "ClawdPet"
  },
  "description": {
    "zh": "手机上的 Clawd：像素悬浮桌宠，可贴边探头。双击打字和绑定的对话聊天，回复以分段气泡显示；跟随 AI 的思考/调工具/完成状态做动作，AI 也能用 <clawd> 标签让它冒泡、做动作。非官方粉丝作品，AGPL-3.0 开源。 内置47个扩展表情；按工作状态和24维情绪自动播放。 支持自由轮播、分页点播和统一大小调节。",
    "en": "Clawd on your phone: a pixel floating pet with edge-peek mode. Double-tap to chat with a bound conversation; it reacts to AI thinking / tool calls and to <clawd> tags. Unofficial fan project, AGPL-3.0."
  },
  "enabled_by_default": true,
  "subpackages": [
    {
      "id": "clawd",
      "entry": "packages/clawd.js",
      "enabled_by_default": true,
      "display_name": {
        "zh": "Clawd 控制",
        "en": "Clawd Control"
      },
      "description": {
        "zh": "让 Clawd 说话、播动作、贴边，以及管理设置与绑定对话",
        "en": "Speak, animate, dock, settings"
      }
    }
  ],
